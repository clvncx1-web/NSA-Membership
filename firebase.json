{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "nsa-verify",
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "server.ps1",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "cleanUrls": true
  }
}
